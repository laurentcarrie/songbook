\path (SECTION_couplet_3) +(-2*\xr+\xr*.25,.25*\yr-\yr*.3) coordinate (A) ;
\node[circle,fill=red,opacity=.9](b) at (A) {} ;


\path (SECTION_refrain_2) +(-2*\xr,-.75*\yr) coordinate (A) ;
\node[circle,fill=red,opacity=.9](b) at (A) {  } ;
\path (A) +(1.5*\xr    ,0) coordinate (B) ;
\node[fill=red,opacity=.9](b) at (B) { STOP on beat 1  } ;

\path (SECTION_refrain_4) +(-2*\xr,-.75*\yr) coordinate (A) ;

\node[anchor=west](b) at (A) {pont : \songly{chordspont}} ;
