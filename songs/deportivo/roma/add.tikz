% Optional TikZ overlay drawn on top of the chord grid.
% Leave empty if the song needs no annotation.
%
% Cells are addressable as (CELL1), (CELL2), ... in grid order, and \xr is one
% cell width. The example below (from hoobastank/the-reason) circles cell 4:
%
% \path (CELL4) +(1*\xr ,-.25*\xr) coordinate (A) ;
% \node[draw,ellipse,dotted,fill=red!10,opacity=1,minimum width=1.3cm,minimum height=.5cm](b) at (A) {
%     {\songbookfont\fontsize{10pt}{10pt}\selectfont A ~ }
% } ;
